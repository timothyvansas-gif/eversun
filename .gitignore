# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template holds no secrets and documents which variables exist.
!.env.example

# vercel
.vercel

# cloudflare (opennext build output, wrangler local state, local secrets)
.open-next/
.wrangler/
.dev.vars*
!.dev.vars.example

# claude code — local settings and the scratch worktrees it creates for
# background tasks. Nothing in here belongs to the project.
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# Beeldmasters: grote exports/raws waar de webassets uit komen.
# De geoptimaliseerde versies staan los in src/images en gaan wel mee.
/src/images/studio/
