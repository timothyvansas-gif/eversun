# Template. Kopieer dit bestand naar `.env.local` en vul je eigen waarden in.
# `.env.local` staat in .gitignore en komt dus nooit in git terecht.
# Uitleg staat in README.md onder "Contactformulier instellen".

# API-sleutel van resend.com. Begint met "re_".
RESEND_API_KEY=

# Naar welk mailadres de berichten uit het formulier gestuurd worden.
# Testfase: je eigen adres. Live: het adres van de studio.
CONTACT_TO_EMAIL=timothyvansas@gmail.com

# Van welk adres de mail verstuurd wordt.
# Testfase: onboarding@resend.dev (werkt direct, zonder DNS-instellingen).
# Live: een adres op het eigen domein, bv. Ever Sun website <site@eversun-assen.nl>
CONTACT_FROM_EMAIL=onboarding@resend.dev
