# Template. Kopieer dit bestand naar `.env.local` en vul je eigen waarden in.
# `.env.local` staat in .gitignore en komt dus nooit in git terecht.
# Uitleg staat in README.md onder "Contactformulier instellen" en
# "Planomgeving instellen".


## ---- Contactformulier ----

# API-sleutel van resend.com. Begint met "re_".
RESEND_API_KEY=

# Naar welk mailadres de berichten uit het formulier gestuurd worden.
# Testfase: je eigen adres. Live: het adres van de studio.
CONTACT_TO_EMAIL=timothyvansas@gmail.com

# Van welk adres de mail verstuurd wordt.
# Testfase: onboarding@resend.dev (werkt direct, zonder DNS-instellingen).
# Live: een adres op het eigen domein, bv. Ever Sun website <site@eversun-assen.nl>
CONTACT_FROM_EMAIL=onboarding@resend.dev


## ---- Planomgeving (Supabase) ----
## Te vinden in het Supabase-dashboard onder Project Settings → API Keys.

# Adres van het Supabase-project, bv. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# De publieke sleutel. Begint met "sb_publishable_"; in oudere projecten heet
# deze de "anon"-sleutel en begint hij met "eyJ". Beide werken.
# Deze mag in de browser staan: hij geeft alleen toegang tot wat de
# databaseregels (Row Level Security) toestaan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# De geheime sleutel. Begint met "sb_secret_"; oudere naam: "service_role".
# LET OP: deze omzeilt alle databaseregels. Nooit in code, nooit in een
# NEXT_PUBLIC_-variabele, nooit doorsturen. Alleen server-side, en pas nodig
# voor de herinneringsmails (fase 8).
SUPABASE_SECRET_KEY=
