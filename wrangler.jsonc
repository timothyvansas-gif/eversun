{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Not .open-next/worker.js directly: worker.mjs wraps it and puts the doctype
	// back in front of every HTML response, which the adapter drops behind a
	// script tag and so leaves every browser in quirks mode. See worker.mjs.
	"main": "worker.mjs",
	"name": "ever-sun",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		// next/image optimization on Workers runs through this binding instead
		// of Next's Node-based optimizer, which isn't available here.
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
